{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "阅间",
  "version": "0.1.1",
  "identifier": "com.yuejian.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "阅间 · 英语精读",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MTc5MEZGNzI5NThCMTIKUldRU2k1VnkvNUFYWjlERTlHN3R5d1dRVU1lYUFacjFHbWVkS0FGZGkxNTNFT0ZoSExBdmMycEEK",
      "endpoints": ["https://github.com/tzq-tbw/yuejian-reader/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
